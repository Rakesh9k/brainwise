# ==============================================================================
# BRAINWISE PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env.local' for local development:
#   cp .env.example .env.local
#
# IMPORTANT:
# - NEVER commit real API keys, secrets, or production credentials to Git.
# - Variables prefixed with 'VITE_' are bundled into the client browser bundle.
# - Unprefixed variables are strictly server-side and invisible to the client.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER-SIDE RUNTIME CONFIGURATION (server.ts / Cloud Functions)
# ------------------------------------------------------------------------------

# Server listen port (defaults to 3000 if omitted)
PORT=3000

# Google Gemini API Key
# Required for server-side AI orchestration (Dossiers, Playbooks, Recommendations)
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Primary Gemini Model identifier
GEMINI_MODEL="gemini-2.5-flash"

# Node Environment ('development' | 'production' | 'test')
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 2. CLIENT-SIDE PUBLIC CONFIGURATION (Browser / Vite)
# ------------------------------------------------------------------------------

# Public canonical URL of the application
# Used for deep links, OAuth redirect URIs, and metadata
VITE_APP_URL="http://localhost:3000"

# Application Title
VITE_APP_TITLE="BrainWise — AI Business Intelligence & Growth Platform"

# ------------------------------------------------------------------------------
# 3. PAYMENT & BILLING GATEWAY CONFIGURATION (Cashfree Payments PG v3)
# ------------------------------------------------------------------------------
# Cashfree App ID / Client ID (Merchant dashboard credentials)
CASHFREE_APP_ID="YOUR_CASHFREE_APP_ID"

# Cashfree Secret Key (Used for API calls and HMAC-SHA256 webhook signature verification)
CASHFREE_SECRET_KEY="YOUR_CASHFREE_SECRET_KEY"

# Cashfree Environment ('sandbox' | 'production')
CASHFREE_ENV="sandbox"

# Cashfree API Version (Standard Cashfree PG API Version)
CASHFREE_API_VERSION="2023-08-01"

# Webhook Callback Notification URL (Targeted by Cashfree webhook deliveries)
CASHFREE_NOTIFY_URL="https://app.brainwise.com/api/v1/billing/webhook"

